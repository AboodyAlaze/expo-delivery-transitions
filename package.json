{
  "name": "expo-delivery-transitions",
  "version": "0.3.1",
  "description": "Creative native page transitions for Expo Router (Android + iOS): delivery bike, delivery car (with your logo), liquid pour, ball zoom, radar, hex, curtain",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "android",
    "animation",
    "expo",
    "expo-router",
    "ios",
    "page-transition",
    "react-native",
    "transitions"
  ],
  "author": "Abdullrahman Alaa (https://github.com/AboodyAlaze)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AboodyAlaze/expo-delivery-transitions.git"
  },
  "bugs": {
    "url": "https://github.com/AboodyAlaze/expo-delivery-transitions/issues"
  },
  "homepage": "https://github.com/AboodyAlaze/expo-delivery-transitions#readme",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.26",
    "expo-router": "~57.0.24",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "expo-router": "*",
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "ios",
    "build",
    "src",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
